# Logging configuration for Webhook To Fedora Messaging.
#
# These are development defaults: the application logger is set to DEBUG and
# everything goes to stdout. For production, set the level in
# [logger_webhook_to_fedora_messaging] to INFO.

[loggers]
keys=root,uvicorn,uvicorn_access,alembic,webhook_to_fedora_messaging

[handlers]
keys=console,access

[formatters]
keys=standard,access

[logger_root]
level=INFO
handlers=console

[logger_uvicorn]
qualname=uvicorn
level=INFO
handlers=console
propagate=0

[logger_uvicorn_access]
qualname=uvicorn.access
level=INFO
handlers=access
propagate=0

[logger_alembic]
qualname=alembic
level=WARNING
handlers=console
propagate=0

[logger_webhook_to_fedora_messaging]
qualname=webhook_to_fedora_messaging
level=DEBUG
handlers=console
propagate=0

[handler_console]
class=StreamHandler
level=DEBUG
formatter=standard
args=(sys.stdout,)

[handler_access]
class=StreamHandler
level=DEBUG
formatter=access
args=(sys.stdout,)

[formatter_standard]
class=uvicorn.logging.DefaultFormatter
format=%(asctime)s %(levelprefix)s %(message)s
datefmt=[%Y-%m-%d %H:%M:%S %z]

[formatter_access]
class=uvicorn.logging.AccessFormatter
format=%(asctime)s %(levelprefix)s %(client_addr)s - '%(request_line)s' %(status_code)s
datefmt=[%Y-%m-%d %H:%M:%S %z]
